# Plantilla del .env. Copiarla con  cp .env.example .env  y completar el .env, nunca este archivo.
# Solo hace falta para desplegar en Sepolia: los tests y la demo local no la usan.
# .env está en .gitignore y no se sube al repositorio. Explicación de cada valor: README, "Configurar el .env".

# --- Obligatorias -----------------------------------------------------------
# Clave privada de la cuenta TITULAR: despliega los contratos y queda como owner.
# Usar una cuenta solo de pruebas y con Sepolia ETH. Sirve con o sin 0x adelante.
PRIVATE_KEY=
# API key de Etherscan (gratis en etherscan.io > API Keys). Con ella el deploy verifica los contratos.
ETHERSCAN_API_KEY=
# Dirección pública (0x...) de cada heredero. No hace falta su clave privada.
HEIR_1=
HEIR_2=

# --- Opcionales -------------------------------------------------------------
# Nodo de Sepolia (Alchemy, Infura...). Vacío = se usa un RPC público.
SEPOLIA_RPC_URL=
# Porcentaje de cada heredero, separados por coma y en el mismo orden. Vacío = 60,40.
HEIR_PERCENTAGES=
# Plazo de inactividad en segundos. Vacío = 1 año. Para la demo: 600 (10 minutos).
INACTIVITY_PERIOD_SECONDS=
