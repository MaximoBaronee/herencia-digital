# Configuración del front. Copiar a .env.local con:  cp .env.example .env.local
# Trae los valores del despliegue actual en Sepolia. Todos son públicos (direcciones
# de contratos, red y un RPC público): no hay ninguna clave ni dato secreto.

# Contratos desplegados (código verificado en sepolia.etherscan.io)
VITE_CONTRACT_ADDRESS=0xe45DB9f8f759Ad34C88C22c07BC4f09a274aa6a0
VITE_WATCHER_ADDRESS=0x68E5FE129B3f51e79bdCfa6eabe7019962b93422

# Red
VITE_CHAIN_ID=11155111
VITE_CHAIN_NAME=Sepolia
VITE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Bloque del deploy: desde ahí se lee la tarjeta "Historial"
VITE_DEPLOY_BLOCK=11941804
