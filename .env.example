# Copiar este archivo a .env y completar solo si se va a desplegar en una testnet.
# Para correr tests y la demo local NO hace falta configurar nada.
# .env está en .gitignore: nunca se sube al repositorio.

# RPC de Sepolia: Alchemy, Infura o uno público (ej. https://ethereum-sepolia-rpc.publicnode.com)
SEPOLIA_RPC_URL=
# Clave privada de la wallet que despliega y queda como TITULAR del contrato (necesita Sepolia ETH)
PRIVATE_KEY=
# API key de Etherscan (etherscan.io > API Keys, gratis); con ella el deploy verifica los contratos solo
ETHERSCAN_API_KEY=
# Direcciones de los herederos (obligatorias fuera de la red local)
HEIR_1=
HEIR_2=
# Porcentaje de cada heredero, separados por coma y en el mismo orden (por defecto 60,40)
HEIR_PERCENTAGES=
# Plazo de inactividad en segundos (por defecto 1 año; 600 = 10 minutos, útil para la demo)
INACTIVITY_PERIOD_SECONDS=
